<% layout("/layouts/boilerplate") %>

<div class="app-review-container">

    <h1>Sanchari Community Reviews</h1>

    <p class="subtitle">
        Tell us about your experience using Sanchari.
    </p>

    <form action="/appreviews" method="POST" class="review-form">

        <input
            type="text"
            name="username"
            placeholder="Your Name"
            required
        >

        <select
            name="rating"
            required
        >
            <option value="">Select Rating</option>

            <option value="5">⭐⭐⭐⭐⭐</option>
            <option value="4">⭐⭐⭐⭐</option>
            <option value="3">⭐⭐⭐</option>
            <option value="2">⭐⭐</option>
            <option value="1">⭐</option>
        </select>

        <textarea
            name="comment"
            rows="4"
            placeholder="Write your review..."
            required
        ></textarea>

        <button type="submit">
            Submit Review
        </button>

    </form>

    <div class="reviews-grid">

        <% appreviews.forEach(review => { %>

            <div class="review-card">

                <h3><%= review.username %></h3>

                <p>
                    Rating:
                    <%= review.rating %>/5 ⭐
                </p>

                <p>
                    <%= review.comment %>
                </p>

            </div>

        <% }) %>

    </div>

</div>